# ==========================================
# SyncWave Production Environment Variables
# ==========================================

# Server Port & Environment
PORT=3000
NODE_ENV=production

# Base URL of your deployed application (e.g. https://syncwave.onrender.com)
BASE_URL=http://localhost:3000

# 32+ character random secret for signing session cookies
SESSION_SECRET=change-this-to-a-secure-random-string-at-least-32-chars-long

# SQLite storage directory (must persist across restarts)
DATA_DIR=./data

# Initial Admin Credentials (created on first launch)
ADMIN_EMAIL=admin@syncwave.local
ADMIN_INITIAL_PASSWORD=supersecurepassword123

# Optional: Jamendo API Client ID for indie music catalog
# JAMENDO_CLIENT_ID=

# Optional: Google OAuth
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Optional: Email SMTP settings
# EMAIL_USER=
# EMAIL_PASS=
