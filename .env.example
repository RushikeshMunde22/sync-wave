# SyncWave Environment Variables
# Copy to .env and fill in values

# ── Required ──────────────────────────────────────────────
# Secret for signing session cookies (min 32 chars, generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
SESSION_SECRET=

# Initial superadmin account (created on first boot)
ADMIN_EMAIL=admin@syncwave.local
ADMIN_INITIAL_PASSWORD=

# ── Optional: Music Providers ─────────────────────────────
# Jamendo API client ID (free at https://devportal.jamendo.com/)
# App works without it, using Audius only
JAMENDO_CLIENT_ID=

# ── Optional: Google OAuth ────────────────────────────────
# Google Sign-In (get free at https://console.cloud.google.com/apis/credentials)
# App works without these, email+password only
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Optional: Configuration ──────────────────────────────
# Port for the server (default: 3000)
PORT=3000

# Base URL for the app (used for OAuth redirect, invite links)
# In production, set to your deployed URL
BASE_URL=http://localhost:3000

# Path to store the SQLite database and backups
DATA_DIR=./data

# Node environment (development | production)
NODE_ENV=development

# ── Optional: Feature Flags ──────────────────────────────
# Disable new signups (true/false, default: false)
SIGNUPS_DISABLED=false

# Max members per group (default: 50)
MAX_GROUP_MEMBERS=50

# ── Optional: Privacy / Legal ────────────────────────────
# DMCA/takedown contact email
DMCA_CONTACT=

# ── Optional: Admin ──────────────────────────────────────
# Announcement banner shown to all users (leave empty for none)
ANNOUNCEMENT_BANNER=
